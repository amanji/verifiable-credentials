{
  "name": "@abgov/verifiable-credentials",
  "version": "1.0.0",
  "packageManager": "yarn@3.6.1",
  "description": "Verifiable Credentials library for Alberta Digital Wallet",
  "repository": {
    "type": "git",
    "url": "https://github.com/GovAlta/verifiable-credentials.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/precompile-validators.mjs && yarn copy:schemas",
    "copy:schemas": "mkdir -p dist/sdjwt/schemas dist/openid-federation/schemas dist/alberta-wallet/schemas && cp src/sdjwt/schemas/*.json dist/sdjwt/schemas/ && cp src/openid-federation/schemas/*.json dist/openid-federation/schemas/ && cp src/alberta-wallet/schemas/*.json dist/alberta-wallet/schemas/",
    "test": "node scripts/precompile-validators.mjs && jest",
    "test:watch": "node scripts/precompile-validators.mjs && jest --watch",
    "test:coverage": "node scripts/precompile-validators.mjs && jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "pack": "yarn pack",
    "prepublishOnly": "yarn build && yarn test"
  },
  "keywords": [
    "verifiable-credentials",
    "wallet",
    "digital-wallet",
    "alberta"
  ],
  "author": "Alberta Digital Wallet Team",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@types/pako": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.2.3",
    "pako": "^2.1.0"
  }
}
