{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://account.alberta.ca/dts/schemas/alberta-credential-issuer-v1.json",
    "title": "Alberta Credential Issuer Configuration v1",
    "description": "Schema for Alberta credential issuer openid-federation entity type",
    "type": "object",
    "required": [
        "organization_name",
        "organization_uri",
        "description",
        "information_uri",
        "credential_configurations_supported"
    ],
    "properties": {
        "organization_name": {
            "type": "string"
        },
        "organization_uri": {
            "type": "string",
            "format": "uri"
        },
        "description": {
            "type": "string"
        },
        "information_uri": {
            "type": "string",
            "format": "uri"
        },
        "credential_configurations_supported": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "pattern": "^[A-Za-z0-9._-]+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/credentialConfiguration"
            }
        },
        "issuer_tz": {
            "type": "string"
        }
    },
    "additionalProperties": false,
    "$defs": {
        "uriRef": {
            "type": "object",
            "required": [
                "uri"
            ],
            "properties": {
                "uri": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "additionalProperties": false
        },
        "credentialConfiguration": {
            "type": "object",
            "required": [
                "typ",
                "description",
                "credential_issuer",
                "jwks_uri",
                "revocation_list_endpoint",
                "revocation_method",
                "credential_definition",
                "credential_display",
                "credential_format",
                "proof_type",
                "cryptographic_suites_supported"
            ],
            "properties": {
                "typ": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "credential_issuer": {
                    "type": "string",
                    "format": "uri"
                },
                "jwks_uri": {
                    "type": "string",
                    "format": "uri"
                },
                "revocation_list_endpoint": {
                    "type": "string",
                    "format": "uri"
                },
                "revocation_method": {
                    "type": "string"
                },
                "credential_definition": {
                    "$ref": "#/$defs/uriRef"
                },
                "credential_display": {
                    "$ref": "#/$defs/uriRef"
                },
                "credential_format": {
                    "type": "string"
                },
                "proof_type": {
                    "type": "object",
                    "required": [
                        "type",
                        "jwks_uri"
                    ],
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "ckapp",
                                "secure-qr-jwt"
                            ]
                        },
                        "jwks_uri": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    "additionalProperties": false
                },
                "cryptographic_suites_supported": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "icon": {
                    "$ref": "#/$defs/uriRef"
                }
            },
            "additionalProperties": false
        }
    }
}