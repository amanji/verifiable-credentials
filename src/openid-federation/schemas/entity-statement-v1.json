{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://account.alberta.ca/dts/schemas/entity-statement-v1.json",
    "title": "OpenID Federation Entity Statement",
    "type": "object",
    "required": [
        "iss",
        "sub",
        "iat",
        "exp",
        "jwks"
    ],
    "properties": {
        "iss": {
            "type": "string",
            "format": "uri"
        },
        "sub": {
            "type": "string",
            "format": "uri"
        },
        "iat": {
            "type": "integer"
        },
        "exp": {
            "type": "integer"
        },
        "jwks": {
            "type": "object",
            "required": [
                "keys"
            ],
            "properties": {
                "keys": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "kid",
                            "kty"
                        ],
                        "properties": {
                            "kid": {
                                "type": "string",
                                "minLength": 1
                            },
                            "kty": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "additionalProperties": true
                    }
                }
            },
            "additionalProperties": true
        },
        "authority_hints": {
            "type": "array",
            "items": {
                "type": "string",
                "format": "uri"
            },
            "minItems": 1
        },
        "trust_anchor_hints": {
            "type": "array",
            "items": {
                "type": "string",
                "format": "uri"
            },
            "minItems": 1
        },
        "metadata": {
            "type": "object",
            "properties": {
                "alberta_credential_issuer": {
                    "$ref": "https://account.alberta.ca/dts/schemas/alberta-credential-issuer-v1.json"
                }
            },
            "additionalProperties": {
                "type": "object",
                "additionalProperties": true
            }
        },
        "metadata_policy": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "metadata_policy_crit": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "minItems": 1
        },
        "constraints": {
            "type": "object",
            "properties": {
                "max_path_length": {
                    "type": "integer",
                    "minimum": 0
                },
                "naming_constraints": {
                    "type": "object",
                    "properties": {
                        "permitted": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "excluded": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "allowed_entity_types": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": true
        },
        "source_endpoint": {
            "type": "string",
            "format": "uri"
        }
    },
    "additionalProperties": true
}